import { afterEach, describe, expect, it } from "bun:test";
import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import {
	addTasks,
	apply,
	applyReview,
	createFileBoardStore,
	createMemoryBoardStore,
	createWriteGateControl,
	initialBoard,
	isAttachReady,
	openBoard,
	progressableSet,
	readBoard,
	registerActor,
	responsibilitySet,
	reviewLedger,
	TAKE_OR_DIE_CONFIRMATION,
	validateDependencyPaths,
	wakeAll,
} from "../src/swarm/board.mjs";
import { isHerdError } from "../src/util/errors.mjs";
import { acquireLock, releaseLock } from "../src/util/file-lock.mjs";

let requestSequence = 0;
const tempRoots = [];

afterEach(() => {
	while (tempRoots.length > 0) {
		rmSync(tempRoots.pop(), { recursive: true, force: true });
	}
});

function tempRoot() {
	const root = mkdtempSync(join(tmpdir(), "herd-board-"));
	tempRoots.push(root);
	return root;
}

async function seededFileBoard(root, slug, sliceId, options = {}) {
	const handle = openBoard(root, slug, sliceId, options);
	await handle.store.initialize(initialBoard());
	return handle;
}

async function seededPlanBoard(root, slug, options = {}) {
	const handle = openBoard(root, slug, { mode: "plan", ...options });
	await handle.store.initialize(initialBoard({ mode: "plan" }));
	return handle;
}

function requestId(prefix = "req") {
	requestSequence += 1;
	return `${prefix}-${requestSequence}`;
}

// The kernel returns U0 HerdError values with keyword codes (`:BOARD_CONFLICT`).
// Tests compare the bare names, so strip the leading colon from the error view.
function bareError(result) {
	if (!result?.error) return result;
	const error = new Error(result.error.message);
	error.code = result.error.code.replace(/^:/, "");
	error.data = result.error.data;
	return { ...result, error };
}

function seedBoard({ actors = [], tasks = [] } = {}) {
	let board = initialBoard();
	for (const agentId of actors) {
		board = registerActor(board, { agentId, slotId: `slot-${agentId}` });
	}
	const created = addTasks(board, tasks);
	return { board: created.board, taskIds: created.taskIds };
}

async function run(board, command, options = {}) {
	return bareError(
		await apply({
			board,
			command,
			actor: options.actor ?? "A",
			turnId: options.turnId ?? "turn-1",
			requestId: options.requestId ?? requestId(),
			expectedBoardVersion: options.expectedBoardVersion,
		}),
	);
}

function tokenTask(goal = "run checks") {
	return {
		goal,
		remainingWork: "run the command and record the result",
		doneWhen: "result recorded",
		needsToken: true,
	};
}

async function claimTask(board, taskId, agentId, options = {}) {
	return run(
		board,
		{
			type: "claim",
			taskId,
			atomicityReason: options.atomicityReason ?? "single result boundary",
		},
		{ actor: agentId, turnId: options.turnId ?? "turn-claim", requestId: options.requestId },
	);
}

async function finishTask(board, taskId, agentId, claimId, options = {}) {
	return run(
		board,
		{
			type: "finish",
			taskId,
			claimId,
			resultSummary: options.resultSummary ?? "result and integration evidence recorded",
			dependencyPaths: options.dependencyPaths ?? ["src/example.mjs"],
		},
		{ actor: agentId, turnId: options.turnId ?? "turn-finish", requestId: options.requestId },
	);
}

describe("board kernel: split and parent substance", () => {
	it("creates children, wait_for and the waiting parent in one transition", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [
				{
					goal: "integrate the change",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
					ownerId: "A",
				},
			],
		});
		const [parentId] = taskIds;
		const before = structuredClone(board);

		const result = await run(
			board,
			{
				type: "split",
				parentId,
				remainingWork: "wire the parser and verify integration",
				children: [
					{
						goal: "parser",
						remainingWork: "parse new syntax",
						doneWhen: "parser test passes",
						needsToken: false,
					},
					{
						goal: "writer",
						remainingWork: "write new syntax",
						doneWhen: "writer test passes",
						needsToken: true,
					},
				],
			},
			{ actor: "A", expectedBoardVersion: 0, requestId: "split-1" },
		);

		expect(result.ok).toBe(true);
		expect(board).toEqual(before);
		const next = result.board;
		const parent = next.tasks[parentId];
		expect(parent.state).toBe("waiting");
		expect(parent["remaining-work"]).toBe("wire the parser and verify integration");
		expect(parent["owner-id"]).toBe("A");
		expect(parent["wait-for"]).toEqual(result.receipt.childIds);
		expect(parent["child-ids"]).toEqual(result.receipt.childIds);
		expect(next["board-version"]).toBe(1);

		for (const childId of result.receipt.childIds) {
			const child = next.tasks[childId];
			expect(child["parent-id"]).toBe(parentId);
			expect(child["owner-id"]).toBeNull();
			expect(child.state).toBe("ready");
		}
		expect(next.requests["split-1"].receipt.outcome).toBe("split");
	});

	it("revives a parent to ready only, then rejects a same-turn finish", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B", "C"],
			tasks: [
				{
					goal: "integrate",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
					ownerId: "A",
				},
			],
		});
		const [parentId] = taskIds;
		const split = await run(
			board,
			{
				type: "split",
				parentId,
				remainingWork: "wire and verify",
				children: [
					{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false },
					{ goal: "two", remainingWork: "two", doneWhen: "two", needsToken: false },
				],
			},
			{ expectedBoardVersion: 0 },
		);
		expect(split.ok).toBe(true);
		const [firstChild, secondChild] = split.receipt.childIds;

		const firstClaim = await claimTask(split.board, firstChild, "B");
		const secondClaim = await claimTask(firstClaim.board, secondChild, "C");
		const firstFinish = await finishTask(secondClaim.board, firstChild, "B", firstClaim.receipt.claimId, {
			turnId: "turn-2",
		});
		expect(firstFinish.board.tasks[parentId].state).toBe("waiting");

		const secondFinish = await finishTask(firstFinish.board, secondChild, "C", secondClaim.receipt.claimId, {
			turnId: "turn-2",
		});
		expect(secondFinish.ok).toBe(true);
		const parent = secondFinish.board.tasks[parentId];
		expect(parent.state).toBe("ready");
		expect(parent.state).not.toBe("done");
		expect(parent["owner-id"]).toBe("A");
		expect(parent["remaining-work"]).toBe("wire and verify");
		expect(parent["wait-for"]).toEqual([]);

		const parentClaim = await claimTask(secondFinish.board, parentId, "A", {
			turnId: "turn-2",
		});
		expect(parentClaim.ok).toBe(true);
		const sameTurn = await finishTask(parentClaim.board, parentId, "A", parentClaim.receipt.claimId, {
			turnId: "turn-2",
		});
		expect(sameTurn.ok).toBe(false);
		expect(sameTurn.error.code).toBe("PARENT_NOT_READY");
		expect(sameTurn.board.tasks[parentId].state).toBe("ready");

		const nextTurn = await finishTask(parentClaim.board, parentId, "A", parentClaim.receipt.claimId, {
			turnId: "turn-3",
		});
		expect(nextTurn.ok).toBe(true);
		expect(nextTurn.board.tasks[parentId].state).toBe("done");
	});

	it("rejects a claim of a waiting parent and a finish without the live claim", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B", "C"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
			],
		});
		const [parentId] = taskIds;
		const split = await run(
			board,
			{
				type: "split",
				parentId,
				remainingWork: "integration",
				children: [{ goal: "child", remainingWork: "work", doneWhen: "done", needsToken: false }],
			},
			{ expectedBoardVersion: 0 },
		);
		const [childId] = split.receipt.childIds;

		const waitingClaim = await claimTask(split.board, parentId, "A");
		expect(waitingClaim.ok).toBe(false);
		expect(waitingClaim.error.code).toBe("TASK_NOT_READY");

		const claim = await claimTask(split.board, childId, "B");
		expect(claim.ok).toBe(true);
		const conflict = await claimTask(claim.board, childId, "C");
		expect(conflict.ok).toBe(false);
		expect(conflict.error.code).toBe("CLAIM_CONFLICT");

		const noClaim = await finishTask(claim.board, childId, "B", "C-999");
		expect(noClaim.ok).toBe(false);
		expect(noClaim.error.code).toBe("CLAIM_CHANGED");

		const wrongActor = await finishTask(claim.board, childId, "C", claim.receipt.claimId);
		expect(wrongActor.ok).toBe(false);
		expect(wrongActor.error.code).toBe("CLAIM_CHANGED");
	});

	it("cancels and replaces only leaves and updates the parent wait set", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
			],
		});
		const [parentId] = taskIds;
		const split = await run(
			board,
			{
				type: "split",
				parentId,
				remainingWork: "integration",
				children: [
					{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false },
					{ goal: "two", remainingWork: "two", doneWhen: "two", needsToken: false },
				],
			},
			{ expectedBoardVersion: 0 },
		);
		const [firstChild, secondChild] = split.receipt.childIds;

		const parentCancel = await run(split.board, {
			type: "cancel",
			taskId: parentId,
			reason: "not now",
		});
		expect(parentCancel.ok).toBe(false);
		expect(parentCancel.error.code).toBe("TASK_HAS_CHILDREN");

		const childCancel = await run(split.board, {
			type: "cancel",
			taskId: firstChild,
			reason: "merged into the other child",
		});
		expect(childCancel.ok).toBe(true);
		expect(childCancel.board.tasks[parentId].state).toBe("waiting");
		expect(childCancel.board.tasks[parentId]["wait-for"]).toEqual([secondChild]);

		const replaced = await run(childCancel.board, {
			type: "replace",
			taskId: secondChild,
			reason: "split the work differently",
			replacement: {
				goal: "two revised",
				remainingWork: "two revised",
				doneWhen: "two revised",
				needsToken: false,
			},
		});
		expect(replaced.ok).toBe(true);
		expect(replaced.board.tasks[secondChild]).toBeUndefined();
		const replacementId = replaced.receipt.replacementId;
		expect(replaced.board.tasks[parentId]["wait-for"]).toEqual([replacementId]);
		expect(replaced.board.tasks[parentId]["child-ids"]).toContain(replacementId);

		const childFinish = await claimTask(replaced.board, replacementId, "A");
		const done = await finishTask(childFinish.board, replacementId, "A", childFinish.receipt.claimId);
		expect(done.board.tasks[parentId].state).toBe("ready");

		const leafCancel = await run(done.board, {
			type: "cancel",
			taskId: parentId,
			reason: "no longer needed after review",
		});
		expect(leafCancel.ok).toBe(true);
		expect(leafCancel.board.tasks[parentId]).toBeUndefined();
	});

	it("accepts direct child ids and condition: keys in explicit wait_for", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
				{ goal: "unrelated", remainingWork: "other", doneWhen: "other", needsToken: false },
			],
		});
		const [parentId, unrelatedId] = taskIds;

		const first = await run(
			board,
			{
				type: "split",
				parentId,
				remainingWork: "integrate the first child",
				children: [{ goal: "first child", remainingWork: "first", doneWhen: "first", needsToken: false }],
			},
			{ expectedBoardVersion: 0, requestId: "first-split" },
		);
		expect(first.ok).toBe(true);
		const [firstChildId] = first.receipt.childIds;
		expect(first.board.tasks[parentId]["wait-for"]).toEqual([firstChildId]);

		const second = await run(
			first.board,
			{
				type: "split",
				parentId,
				remainingWork: "integrate both children",
				children: [{ goal: "second child", remainingWork: "second", doneWhen: "second", needsToken: false }],
				waitFor: [firstChildId, "condition:gate-open"],
			},
			{ expectedBoardVersion: first.board["board-version"], requestId: "explicit-wait" },
		);
		expect(second.ok).toBe(true);
		expect(second.board.tasks[parentId]["wait-for"]).toEqual([firstChildId, "condition:gate-open"]);
		expect(second.board.tasks[parentId]["wait-for"].every((entry) => typeof entry === "string")).toBe(true);

		for (const [requestId, waitFor] of [
			["unrelated-wait", [unrelatedId]],
			["self-wait", [parentId]],
			["bare-condition", ["gate-open"]],
			["empty-condition", ["condition:"]],
			["object-condition", [{ condition: "gate-open" }]],
			// The next split would create T-5; explicit wait_for only names existing children.
			["new-child-wait", ["T-5"]],
		]) {
			const rejected = await run(
				second.board,
				{
					type: "split",
					parentId,
					remainingWork: "invalid wait",
					children: [{ goal: "invalid", remainingWork: "invalid", doneWhen: "invalid", needsToken: false }],
					waitFor,
				},
				{ expectedBoardVersion: second.board["board-version"], requestId },
			);
			expect(rejected.ok).toBe(false);
			expect(rejected.error.code).toBe("INVALID_ARGUMENT");
		}

		const cancelledChild = await run(
			second.board,
			{ type: "cancel", taskId: firstChildId, reason: "remove the first child" },
			{ actor: "A", requestId: "cancel-first-child" },
		);
		expect(cancelledChild.ok).toBe(true);
		const oldTaskId = await run(
			cancelledChild.board,
			{
				type: "split",
				parentId,
				remainingWork: "old task id",
				children: [{ goal: "old", remainingWork: "old", doneWhen: "old", needsToken: false }],
				waitFor: [firstChildId],
			},
			{
				expectedBoardVersion: cancelledChild.board["board-version"],
				requestId: "old-task-wait",
			},
		);
		expect(oldTaskId.ok).toBe(false);
		expect(oldTaskId.error.code).toBe("INVALID_ARGUMENT");
	});

	it("revives a split parent whose declared partial wait is already satisfied", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
			],
		});
		const [parentId] = taskIds;
		const condition = await run(
			board,
			{ type: "resolveCondition", key: "gate-open", value: true },
			{ actor: "A", requestId: "condition-open" },
		);
		expect(condition.ok).toBe(true);

		const split = await run(
			condition.board,
			{
				type: "split",
				parentId,
				expectedBoardVersion: condition.board["board-version"],
				remainingWork: "integration",
				children: [{ goal: "child", remainingWork: "work", doneWhen: "done", needsToken: false }],
				waitFor: ["condition:gate-open"],
			},
			{ actor: "A", requestId: "split-satisfied-condition" },
		);
		expect(split.ok).toBe(true);
		const childId = split.receipt.childIds[0];
		expect(split.board.tasks[parentId].state).toBe("ready");
		expect(split.board.tasks[parentId]["wait-for"]).toEqual([]);
		expect(split.receipt.revivedParentIds).toEqual([parentId]);
		expect(split.board.tasks[childId].state).toBe("ready");
		expect(progressableSet(split.board).map((item) => item.id)).toEqual(
			expect.arrayContaining([parentId, childId]),
		);

		const claim = await claimTask(split.board, parentId, "A");
		expect(claim.ok).toBe(true);
		const sameTurn = await finishTask(claim.board, parentId, "A", claim.receipt.claimId, {
			turnId: "turn-1",
		});
		expect(sameTurn.ok).toBe(false);
		expect(sameTurn.error.code).toBe("PARENT_NOT_READY");

		const nextTurn = await finishTask(claim.board, parentId, "A", claim.receipt.claimId, {
			turnId: "turn-2",
		});
		expect(nextTurn.ok).toBe(true);
		expect(nextTurn.board.tasks[parentId].state).toBe("done");
		expect(nextTurn.board.tasks[childId].state).toBe("ready");
	});

	it("keeps a condition-only parent waiting until its condition resolves", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
			],
		});
		const [parentId] = taskIds;
		const split = await run(
			board,
			{
				type: "split",
				parentId,
				expectedBoardVersion: board["board-version"],
				remainingWork: "integration",
				children: [{ goal: "child", remainingWork: "work", doneWhen: "done", needsToken: false }],
				waitFor: ["condition:gate-open"],
			},
			{ actor: "A", requestId: "split-condition-only" },
		);
		expect(split.ok).toBe(true);
		const childId = split.receipt.childIds[0];
		expect(split.board.tasks[parentId].state).toBe("waiting");
		expect(split.board.tasks[parentId]["wait-for"]).toEqual(["condition:gate-open"]);
		expect(split.receipt.revivedParentIds).toEqual([]);

		const childClaim = await claimTask(split.board, childId, "A");
		const childFinish = await finishTask(childClaim.board, childId, "A", childClaim.receipt.claimId, {
			turnId: "turn-2",
		});
		expect(childFinish.board.tasks[parentId].state).toBe("waiting");

		const resolved = await run(
			childFinish.board,
			{ type: "resolveCondition", key: "gate-open", value: true },
			{ actor: "A", turnId: "turn-3", requestId: "condition-resolve" },
		);
		expect(resolved.ok).toBe(true);
		expect(resolved.board.tasks[parentId].state).toBe("ready");
		expect(resolved.board.tasks[parentId]["wait-for"]).toEqual([]);
	});

	it("accepts workspace-relative dependency paths and rejects escapes", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;
		const claim = await claimTask(board, taskId, "A");

		for (const badPath of ["/abs/path", "../outside", "src/../../outside"]) {
			const rejected = await finishTask(claim.board, taskId, "A", claim.receipt.claimId, {
				dependencyPaths: [badPath],
			});
			expect(rejected.ok).toBe(false);
			expect(rejected.error.code).toBe("INVALID_ARGUMENT");
			expect(rejected.board.tasks[taskId].state).toBe("ready");
			expect(rejected.board.tasks[taskId]["claim-id"]).toBe(claim.receipt.claimId);
		}

		const accepted = await finishTask(claim.board, taskId, "A", claim.receipt.claimId, {
			dependencyPaths: ["T-1", "src/example.mjs", "contracts/../src/x"],
			requestId: "finish-relative-paths",
		});
		expect(accepted.ok).toBe(true);
		expect(accepted.board.tasks[taskId]["dependency-paths"]).toEqual([
			"T-1",
			"src/example.mjs",
			"contracts/../src/x",
		]);
		expect(accepted.board.tasks[taskId]["result-refs"]).toEqual([]);
	});

	it("exposes the same workspace-relative dependency validator to callers", () => {
		expect(validateDependencyPaths(["T-1", "src/x", "a/../b", "src/x"])).toEqual([
			"T-1",
			"src/x",
			"a/../b",
		]);
		expect(validateDependencyPaths(["/x"])).toBeNull();
		expect(validateDependencyPaths(["../x"])).toBeNull();
		expect(validateDependencyPaths([])).toEqual([]);
	});

	it("releases a parent claim atomically when splitting", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
			],
		});
		const [parentId] = taskIds;
		const claim = await claimTask(board, parentId, "B");
		const preparing = await run(
			claim.board,
			{
				type: "startAction",
				taskId: parentId,
				claimId: claim.receipt.claimId,
				kind: "edit",
				phase: "preparing",
			},
			{ actor: "B", requestId: "split-parent-preparing" },
		);
		expect(preparing.ok).toBe(true);
		const split = await run(
			preparing.board,
			{
				type: "split",
				parentId,
				remainingWork: "integrate the child",
				children: [{ goal: "child", remainingWork: "work", doneWhen: "done", needsToken: false }],
			},
			{
				actor: "A",
				expectedBoardVersion: preparing.board["board-version"],
				requestId: "split-claimed-parent",
			},
		);
		expect(split.ok).toBe(true);
		expect(split.receipt.releasedClaimId).toBe(claim.receipt.claimId);
		expect(split.board.tasks[parentId]["claim-id"]).toBeNull();
		expect(split.board.tasks[parentId]["claim-owner-id"]).toBeNull();
		expect(split.board.tasks[parentId]["owner-id"]).toBe("B");
		expect(split.board.actions[preparing.receipt.actionId]).toBeUndefined();
		expect(split.board.actors.B["active-action-id"]).toBeNull();

		const [childId] = split.receipt.childIds;
		const childClaim = await claimTask(split.board, childId, "A");
		const childFinish = await finishTask(childClaim.board, childId, "A", childClaim.receipt.claimId, {
			turnId: "turn-2",
		});
		expect(childFinish.board.tasks[parentId].state).toBe("ready");
		const parentClaim = await claimTask(childFinish.board, parentId, "B");
		expect(parentClaim.ok).toBe(true);
	});

	it("rejects a stale expected_board_version without touching the winner split", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
			],
		});
		const [parentId] = taskIds;
		const first = await run(
			board,
			{
				type: "split",
				parentId,
				remainingWork: "integration A",
				children: [{ goal: "A", remainingWork: "A", doneWhen: "A", needsToken: false }],
			},
			{ actor: "A", expectedBoardVersion: 0 },
		);
		expect(first.ok).toBe(true);

		const stale = await run(
			first.board,
			{
				type: "split",
				parentId,
				remainingWork: "integration B",
				children: [{ goal: "B", remainingWork: "B", doneWhen: "B", needsToken: false }],
			},
			{ actor: "B", expectedBoardVersion: 0 },
		);
		expect(stale.ok).toBe(false);
		expect(stale.error.code).toBe("BOARD_CONFLICT");
		expect(stale.error.data.current).toBe(1);
		expect(stale.error.data.summary.tasks.length).toBe(2);
		expect(stale.board).toEqual(first.board);
	});

	it("revives a parent when the last unfinished waiter is cancelled", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [
				{
					goal: "parent",
					remainingWork: "integration",
					doneWhen: "integrated",
					needsToken: false,
				},
			],
		});
		const [parentId] = taskIds;
		const split = await run(
			board,
			{
				type: "split",
				parentId,
				remainingWork: "integration",
				children: [
					{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false },
					{ goal: "two", remainingWork: "two", doneWhen: "two", needsToken: false },
				],
			},
			{ expectedBoardVersion: 0 },
		);
		const [firstChild, secondChild] = split.receipt.childIds;
		const claim = await claimTask(split.board, firstChild, "A");
		const finish = await finishTask(claim.board, firstChild, "A", claim.receipt.claimId, { turnId: "turn-2" });
		expect(finish.board.tasks[parentId].state).toBe("waiting");

		const cancelled = await run(
			finish.board,
			{ type: "cancel", taskId: secondChild, reason: "merged into the finished child" },
			{ actor: "A", turnId: "turn-3" },
		);
		expect(cancelled.ok).toBe(true);
		expect(cancelled.board.tasks[parentId].state).toBe("ready");
		expect(cancelled.board.tasks[parentId]["wait-for"]).toEqual([]);
	});
});

describe("board kernel: idempotency and claims", () => {
	it("returns the original receipt for the same request id and payload", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [
				{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false },
				{ goal: "two", remainingWork: "two", doneWhen: "two", needsToken: false },
			],
		});
		const [firstTask, secondTask] = taskIds;
		const command = {
			type: "claim",
			taskId: firstTask,
			atomicityReason: "single result boundary",
		};
		const first = await run(board, command, { actor: "B", requestId: "idem-claim" });
		expect(first.ok).toBe(true);
		const replay = await run(first.board, command, {
			actor: "B",
			requestId: "idem-claim",
			turnId: "turn-2",
		});
		expect(replay.ok).toBe(true);
		expect(replay.replayed).toBe(true);
		expect(replay.receipt.claimId).toBe(first.receipt.claimId);
		expect(replay.board["board-version"]).toBe(first.board["board-version"]);

		const mismatch = await run(
			first.board,
			{ ...command, taskId: secondTask },
			{ actor: "B", requestId: "idem-claim" },
		);
		expect(mismatch.ok).toBe(false);
		expect(mismatch.error.code).toBe("CALL_REPLAY_MISMATCH");
	});

	it("requires a non-empty atomicity reason and an alive actor", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;
		const emptyReason = await run(board, { type: "claim", taskId, atomicityReason: "" });
		expect(emptyReason.ok).toBe(false);
		expect(emptyReason.error.code).toBe("INVALID_ARGUMENT");

		const deadActor = await run(board, { type: "claim", taskId, atomicityReason: "one result" }, { actor: "ghost" });
		expect(deadActor.ok).toBe(false);
		expect(deadActor.error.code).toBe("ACTOR_DEAD");
	});

	it("rejects a take request id already used by another command without half-accepting", async () => {
		const store = createMemoryBoardStore({ initial: initialBoard() });
		const handle = openBoard("/tmp/herd-half-accept", "slug", "slice", { store });
		await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "dup",
		});
		await apply({
			board: handle,
			command: { type: "addTasks", tasks: [tokenTask()] },
			actor: "A",
			turnId: "turn-1",
			requestId: "dup-add",
		});
		const take = await apply({
			board: handle,
			command: {
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A hands off",
			},
			actor: "A",
			turnId: "turn-2",
			requestId: "dup",
		});
		expect(take.ok).toBe(false);
		expect(take.error.code).toBe(":CALL_REPLAY_MISMATCH");

		const state = await readBoard(handle);
		expect(state["take-attempts"]).toEqual({});
		expect(state["token-slot"]["holder-id"]).toBeNull();
		const comment = await apply({
			board: handle,
			command: { type: "comment", taskId: "T-1", text: "actor is not pending" },
			actor: "A",
			turnId: "turn-3",
			requestId: "dup-comment",
		});
		expect(comment.ok).toBe(true);
	});

	it("rejects a take request id already used by a previous take outcome", async () => {
		const store = createMemoryBoardStore({ initial: initialBoard() });
		const handle = openBoard("/tmp/herd-half-accept-take", "slug", "slice", { store });
		await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "take-outcome-register-A",
		});
		await apply({
			board: handle,
			command: { type: "registerActor", agentId: "B", slotId: "slot-B" },
			turnId: "turn-1",
			requestId: "take-outcome-register-B",
		});
		await apply({
			board: handle,
			command: { type: "addTasks", tasks: [tokenTask()] },
			actor: "A",
			turnId: "turn-1",
			requestId: "take-outcome-add",
		});
		const accepted = await apply({
			board: handle,
			command: {
				type: "acceptTake",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A hands off",
			},
			actor: "A",
			turnId: "turn-2",
			requestId: "a",
		});
		expect(accepted.ok).toBe(true);
		const resolved = await apply({
			board: handle,
			command: { type: "resolveTake", attemptId: "a" },
			actor: "A",
			turnId: "turn-3",
			requestId: "r",
		});
		expect(resolved.ok).toBe(true);
		expect(resolved.receipt.outcome).toBe("attempt-won");

		const reused = await apply({
			board: handle,
			command: {
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "B hands off",
			},
			actor: "B",
			turnId: "turn-4",
			requestId: "r",
		});
		expect(reused.ok).toBe(false);
		expect(reused.error.code).toBe(":CALL_REPLAY_MISMATCH");

		const state = await readBoard(handle);
		expect(state["take-attempts"]["r:accept"]).toBeUndefined();
		expect(state.actors.B["life-state"]).toBe("alive");
		const comment = await apply({
			board: handle,
			command: { type: "comment", taskId: "T-1", text: "B is not pending" },
			actor: "B",
			turnId: "turn-5",
			requestId: "take-outcome-comment",
		});
		expect(comment.ok).toBe(true);
	});

	it("releases a claim back to the public pool", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;
		const claim = await claimTask(board, taskId, "A");
		expect(claim.board.tasks[taskId]["owner-id"]).toBe("A");

		const released = await run(claim.board, {
			type: "release",
			taskId,
			claimId: claim.receipt.claimId,
		});
		expect(released.ok).toBe(true);
		expect(released.board.tasks[taskId]["owner-id"]).toBeNull();
		expect(released.board.tasks[taskId]["claim-id"]).toBeNull();

		const nextClaim = await claimTask(released.board, taskId, "B");
		expect(nextClaim.ok).toBe(true);
		expect(nextClaim.board.tasks[taskId]["owner-id"]).toBe("B");
	});

	it("releases before applying and refuses to release after applying", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;

		const claim = await claimTask(board, taskId, "A");
		const preparing = await run(
			claim.board,
			{
				type: "startAction",
				taskId,
				claimId: claim.receipt.claimId,
				kind: "edit",
				phase: "preparing",
			},
			{ actor: "A", requestId: "release-preparing" },
		);
		expect(preparing.ok).toBe(true);

		const released = await run(
			preparing.board,
			{ type: "release", taskId, claimId: claim.receipt.claimId },
			{ actor: "A", requestId: "release-before-applying" },
		);
		expect(released.ok).toBe(true);
		expect(released.board.tasks[taskId]["claim-id"]).toBeNull();
		expect(released.board.tasks[taskId]["owner-id"]).toBeNull();
		expect(released.board.actions[preparing.receipt.actionId]).toBeUndefined();
		expect(released.board.actors.A["active-action-id"]).toBeNull();

		const secondClaim = await claimTask(released.board, taskId, "B");
		expect(secondClaim.ok).toBe(true);
		const applying = await run(
			secondClaim.board,
			{
				type: "startAction",
				taskId,
				claimId: secondClaim.receipt.claimId,
				kind: "edit",
				phase: "applying",
			},
			{ actor: "B", requestId: "release-applying-start" },
		);
		expect(applying.ok).toBe(true);

		const refused = await run(
			applying.board,
			{ type: "release", taskId, claimId: secondClaim.receipt.claimId },
			{ actor: "B", requestId: "release-after-applying" },
		);
		expect(refused.ok).toBe(false);
		expect(refused.error.code).toBe("CLAIM_CHANGED");
		expect(refused.board.tasks[taskId]["claim-id"]).toBe(secondClaim.receipt.claimId);
		expect(refused.board.actions[applying.receipt.actionId].phase).toBe("applying");
	});
});

describe("board kernel: token race and death", () => {
	it("makes exactly one Holder and kills the losing attempt", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [tokenTask()],
		});
		const [tokenTaskId] = taskIds;
		const take = (actor, id) =>
			run(
				board,
				{
					type: "takeOrDie",
					confirm: TAKE_OR_DIE_CONFIRMATION,
					handoffMarkdown: `${actor} hands off the parser notes`,
				},
				{ actor, requestId: id },
			);

		const win = await take("A", "take-A");
		expect(win.ok).toBe(true);
		expect(win.receipt.outcome).toBe("attempt-won");
		expect(win.board["token-slot"]["holder-id"]).toBe("A");
		expect(win.board.actors.A.role).toBe("holder");

		const lossBoard = win.board;
		const loss = await run(
			lossBoard,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "B hands off the parser notes",
			},
			{ actor: "B", requestId: "take-B" },
		);
		expect(loss.ok).toBe(true);
		expect(loss.receipt.outcome).toBe("attempt-lost");
		expect(loss.board["token-slot"]["holder-id"]).toBe("A");
		expect(loss.board.actors.B["life-state"]).toBe("dead");

		const replay = await run(
			loss.board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "B hands off the parser notes",
			},
			{ actor: "B", requestId: "take-B" },
		);
		expect(replay.ok).toBe(true);
		expect(replay.replayed).toBe(true);
		expect(replay.receipt.outcome).toBe("attempt-lost");

		const deadSubmit = await run(
			loss.board,
			{
				type: "comment",
				taskId: tokenTaskId,
				text: "late work",
			},
			{ actor: "B" },
		);
		expect(deadSubmit.ok).toBe(false);
		expect(deadSubmit.error.code).toBe("ACTOR_DEAD");

		expect(responsibilitySet(loss.board, "A").length).toBe(1);
	});

	it("retires a Holder with no responsibility and retires the term", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [tokenTask()],
		});
		const [taskId] = taskIds;
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the checks",
			},
			{ actor: "A", requestId: "take-retire" },
		);
		const termId = win.receipt.termId;
		const claim = await claimTask(win.board, taskId, "A");
		expect(claim.ok).toBe(true);
		const finish = await finishTask(claim.board, taskId, "A", claim.receipt.claimId, { turnId: "turn-2" });
		expect(finish.ok).toBe(true);
		expect(finish.receipt["holder-retired"]).toBeTruthy();
		expect(finish.board["token-slot"].state).toBe("free");
		expect(finish.board["token-slot"]["holder-id"]).toBeNull();
		expect(finish.board["token-slot"]["retired-terms"]).toContain(termId);
		expect(finish.board.actors.A["life-state"]).toBe("dead");

		const late = await run(
			finish.board,
			{ type: "comment", taskId, text: "late" },
			{ actor: { agentId: "A", termId } },
		);
		expect(late.ok).toBe(false);
		expect(late.error.code).toBe("TENURE_RETIRED");
	});

	it("carries new token work to the live Holder and only retires after the last one", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [tokenTask("first"), tokenTask("second")],
		});
		const [firstTask, secondTask] = taskIds;
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes both checks",
			},
			{ actor: "A", requestId: "take-two" },
		);
		expect(win.ok).toBe(true);
		expect(responsibilitySet(win.board, "A").length).toBe(2);

		const firstClaim = await claimTask(win.board, firstTask, "A");
		const firstFinish = await finishTask(firstClaim.board, firstTask, "A", firstClaim.receipt.claimId, {
			turnId: "turn-2",
		});
		expect(firstFinish.ok).toBe(true);
		expect(firstFinish.board["token-slot"]["holder-id"]).toBe("A");
		expect(responsibilitySet(firstFinish.board, "A").length).toBe(1);

		const secondClaim = await claimTask(firstFinish.board, secondTask, "A");
		const secondFinish = await finishTask(secondClaim.board, secondTask, "A", secondClaim.receipt.claimId, {
			turnId: "turn-3",
		});
		expect(secondFinish.ok).toBe(true);
		expect(secondFinish.board["token-slot"]["holder-id"]).toBeNull();
		expect(secondFinish.board.actors.A["life-state"]).toBe("dead");
	});

	it("adds new token work after the win without rewriting the ordinary owner", async () => {
		const { board } = seedBoard({
			actors: ["A", "B", "C"],
			tasks: [tokenTask("first")],
		});
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the checks",
			},
			{ actor: "A", requestId: "new-token-win" },
		);
		expect(win.ok).toBe(true);

		const added = await run(
			win.board,
			{
				type: "addTasks",
				tasks: [
					{
						goal: "new token work",
						remainingWork: "run the new check",
						doneWhen: "checked",
						needsToken: true,
						ownerId: "B",
					},
				],
			},
			{ actor: "C", requestId: "new-token-add" },
		);
		expect(added.ok).toBe(true);
		expect(responsibilitySet(added.board, "A").length).toBe(2);
		const newTaskId = added.receipt.taskIds[0];
		expect(added.board.tasks[newTaskId]["owner-id"]).toBe("B");

		const claim = await claimTask(added.board, newTaskId, "A");
		expect(claim.ok).toBe(true);
		expect(claim.board.tasks[newTaskId]["owner-id"]).toBe("B");
		expect(claim.board.tasks[newTaskId]["claim-owner-id"]).toBe("A");
		const finish = await finishTask(claim.board, newTaskId, "A", claim.receipt.claimId, { turnId: "turn-2" });
		expect(finish.ok).toBe(true);
		expect(finish.board["token-slot"]["holder-id"]).toBe("A");
	});

	it("keeps the Holder alive when new token work arrives before the last finish", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "C"],
			tasks: [tokenTask("first")],
		});
		const [firstTask] = taskIds;
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the first check",
			},
			{ actor: "A", requestId: "t05-win" },
		);
		const added = await run(
			win.board,
			{
				type: "addTasks",
				tasks: [tokenTask("second")],
			},
			{ actor: "C", requestId: "t05-add" },
		);
		const secondTask = added.receipt.taskIds[0];
		const claim = await claimTask(added.board, firstTask, "A");
		const finish = await finishTask(claim.board, firstTask, "A", claim.receipt.claimId, { turnId: "turn-2" });
		expect(finish.ok).toBe(true);
		expect(finish.board["token-slot"]["holder-id"]).toBe("A");
		expect(finish.board.actors.A["life-state"]).toBe("alive");
		expect(responsibilitySet(finish.board, "A").map((item) => item.id)).toEqual([secondTask]);
	});

	it("does not resurrect a retired Holder when new token work arrives later", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B", "C"],
			tasks: [tokenTask()],
		});
		const [firstTask] = taskIds;
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the check",
			},
			{ actor: "A", requestId: "retire-first" },
		);
		const claim = await claimTask(win.board, firstTask, "A");
		const finish = await finishTask(claim.board, firstTask, "A", claim.receipt.claimId, { turnId: "turn-2" });
		expect(finish.board["token-slot"]["holder-id"]).toBeNull();
		expect(finish.board.actors.A["life-state"]).toBe("dead");

		const added = await run(
			finish.board,
			{
				type: "addTasks",
				tasks: [tokenTask("late token work")],
			},
			{ actor: "C", requestId: "late-token-add" },
		);
		expect(added.ok).toBe(true);
		expect(added.board["token-slot"]["holder-id"]).toBeNull();
		expect(added.board.actors.A["life-state"]).toBe("dead");

		const bWin = await run(
			added.board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "B takes the late check",
			},
			{ actor: "B", requestId: "late-token-win" },
		);
		expect(bWin.ok).toBe(true);
		expect(bWin.receipt.outcome).toBe("attempt-won");
		expect(bWin.board["token-slot"]["holder-id"]).toBe("B");
		expect(bWin.board.actors.A["life-state"]).toBe("dead");
	});

	it("returns a positive no-work receipt when no token task exists", async () => {
		const { board } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "ordinary", remainingWork: "work", doneWhen: "done", needsToken: false }],
		});
		const attempt = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A has nothing to hand off",
			},
			{ actor: "A", requestId: "empty-token" },
		);
		expect(attempt.ok).toBe(true);
		expect(attempt.receipt.code).toBe("NO_PROGRESSABLE_WORK");
		expect(attempt.changed).toBe(false);
		expect(attempt.board).toEqual(board);
	});

	it("requires the exact irreversible confirmation string", async () => {
		const { board } = seedBoard({ actors: ["A"], tasks: [tokenTask()] });
		const attempt = await run(
			board,
			{
				type: "takeOrDie",
				confirm: "i-agree",
				handoffMarkdown: "A tries to take the token",
			},
			{ actor: "A", requestId: "bad-confirm" },
		);
		expect(attempt.ok).toBe(false);
		expect(attempt.error.code).toBe("CONFIRMATION_REQUIRED");
		expect(attempt.board["token-slot"]["holder-id"]).toBeNull();
		expect(attempt.board).toEqual(board);
	});

	it("splits a token task atomically into ordinary and token children", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [tokenTask()],
		});
		const [tokenTaskId] = taskIds;
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the check",
			},
			{ actor: "A", requestId: "split-token-win" },
		);
		const split = await run(
			win.board,
			{
				type: "split",
				parentId: tokenTaskId,
				remainingWork: "integrate the two child results",
				children: [
					{ goal: "prep", remainingWork: "prepare", doneWhen: "prepared", needsToken: false },
					{ goal: "check", remainingWork: "check", doneWhen: "checked", needsToken: true },
				],
			},
			{ expectedBoardVersion: win.board["board-version"] },
		);
		expect(split.ok).toBe(true);
		expect(split.board.actors.A["life-state"]).toBe("alive");
		const parent = split.board.tasks[tokenTaskId];
		expect(parent.state).toBe("waiting");
		expect(parent["needs-token"]).toBe(true);
		const tokenChild = split.receipt.childIds[1];
		expect(split.board.tasks[tokenChild]["needs-token"]).toBe(true);
		expect(responsibilitySet(split.board, "A").length).toBe(2);
	});

	it("keeps a running call as Holder responsibility after task cancellation (T09)", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [tokenTask()],
		});
		const [taskId] = taskIds;
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the checks",
			},
			{ actor: "A", requestId: "t09-take" },
		);
		const claim = await claimTask(win.board, taskId, "A");
		const running = await run(
			claim.board,
			{
				type: "startAction",
				taskId,
				claimId: claim.receipt.claimId,
				kind: "shell",
				phase: "running",
			},
			{ actor: "A", requestId: "t09-action" },
		);
		expect(running.ok).toBe(true);
		const actionId = running.receipt.actionId;

		const splitAttempt = await run(
			running.board,
			{
				type: "split",
				parentId: taskId,
				remainingWork: "split while call runs",
				children: [{ goal: "child", remainingWork: "child", doneWhen: "child", needsToken: false }],
			},
			{
				actor: "B",
				expectedBoardVersion: running.board["board-version"],
				requestId: "t09-split",
			},
		);
		expect(splitAttempt.ok).toBe(false);
		expect(splitAttempt.error.code).toBe("TASK_NOT_READY");

		const cancelled = await run(
			running.board,
			{ type: "cancel", taskId, reason: "user cancelled the task while call runs" },
			{ actor: "B", requestId: "t09-cancel" },
		);
		expect(cancelled.ok).toBe(true);
		expect(cancelled.board.tasks[taskId]).toBeUndefined();
		expect(cancelled.board["token-slot"]["holder-id"]).toBe("A");
		expect(cancelled.board.actors.A["life-state"]).toBe("alive");
		expect(responsibilitySet(cancelled.board, "A").some((item) => item.kind === "action" && item.id === actionId)).toBe(
			true,
		);

		const finished = await run(
			cancelled.board,
			{ type: "setActionPhase", actionId, phase: "finished" },
			{ actor: "A", requestId: "t09-finish-action" },
		);
		expect(finished.ok).toBe(true);
		expect(finished.board["token-slot"]["holder-id"]).toBeNull();
		expect(finished.board.actors.A["life-state"]).toBe("dead");
	});

	it("retires a Holder whose only action is preparing after task cancellation", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [tokenTask()],
		});
		const [taskId] = taskIds;
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the checks",
			},
			{ actor: "A", requestId: "preparing-take" },
		);
		const claim = await claimTask(win.board, taskId, "A");
		const preparing = await run(
			claim.board,
			{
				type: "startAction",
				taskId,
				claimId: claim.receipt.claimId,
				kind: "edit",
				phase: "preparing",
			},
			{ actor: "A", requestId: "preparing-action" },
		);
		expect(preparing.ok).toBe(true);
		const cancelled = await run(
			preparing.board,
			{ type: "cancel", taskId, reason: "task cancelled before applying" },
			{ actor: "B", requestId: "preparing-cancel" },
		);
		expect(cancelled.ok).toBe(true);
		expect(cancelled.board["token-slot"]["holder-id"]).toBeNull();
		expect(cancelled.board.actors.A["life-state"]).toBe("dead");
		expect(cancelled.board.actions[preparing.receipt.actionId]).toBeUndefined();
		expect(progressableSet(cancelled.board)).toEqual([]);
		const parked = await run(
			cancelled.board,
			{ type: "parkSlot", observedBoardVersion: cancelled.board["board-version"] },
			{ actor: "B", requestId: "preparing-park" },
		);
		expect(parked.ok).toBe(true);
	});

	it("keeps the Holder alive when its waiting parent is revived (T07)", async () => {
		const seeded = seedBoard({
			actors: ["A"],
			tasks: [
				tokenTask(),
				{
					goal: "parent integration",
					remainingWork: "integrate after the child",
					doneWhen: "integrated",
					needsToken: false,
					ownerId: "A",
				},
				{
					goal: "child work",
					remainingWork: "do the child",
					doneWhen: "child done",
					needsToken: false,
				},
			],
		});
		const board = seeded.board;
		const [tokenTaskId, parentId, childId] = seeded.taskIds;
		board.tasks[parentId].state = "waiting";
		board.tasks[parentId]["wait-for"] = [childId];
		board.tasks[parentId]["child-ids"] = [childId];
		board.tasks[childId]["parent-id"] = parentId;

		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the checks",
			},
			{ actor: "A", requestId: "t07-take" },
		);
		const claim = await claimTask(win.board, childId, "A");
		const finished = await finishTask(claim.board, childId, "A", claim.receipt.claimId, { turnId: "turn-2" });
		expect(finished.ok).toBe(true);
		expect(finished.board.tasks[parentId].state).toBe("ready");
		expect(finished.board.tasks[parentId]["owner-id"]).toBe("A");
		expect(finished.board.tasks[parentId].state).not.toBe("done");
		expect(finished.board["token-slot"]["holder-id"]).toBe("A");
		expect(finished.board.actors.A["life-state"]).toBe("alive");
		expect(
			responsibilitySet(finished.board, "A")
				.map((item) => item.id)
				.sort(),
		).toEqual([parentId, tokenTaskId].sort());
	});

	it("keeps a parent's ordinary owner when the Holder completes its token child (T08)", async () => {
		const seeded = seedBoard({
			actors: ["A", "B"],
			tasks: [
				tokenTask("holder checks"),
				{
					goal: "parent integration",
					remainingWork: "integrate after the child",
					doneWhen: "integrated",
					needsToken: false,
					ownerId: "B",
				},
				{
					goal: "token child",
					remainingWork: "run the child check",
					doneWhen: "child checked",
					needsToken: true,
				},
			],
		});
		const board = seeded.board;
		const [holderTaskId, parentId, childId] = seeded.taskIds;
		board.tasks[parentId].state = "waiting";
		board.tasks[parentId]["wait-for"] = [childId];
		board.tasks[parentId]["child-ids"] = [childId];
		board.tasks[childId]["parent-id"] = parentId;

		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the checks",
			},
			{ actor: "A", requestId: "t08-take" },
		);
		const claim = await claimTask(win.board, childId, "A");
		const finished = await finishTask(claim.board, childId, "A", claim.receipt.claimId, { turnId: "turn-2" });
		expect(finished.ok).toBe(true);
		expect(finished.board.tasks[parentId].state).toBe("ready");
		expect(finished.board.tasks[parentId]["owner-id"]).toBe("B");
		expect(finished.board["token-slot"]["holder-id"]).toBe("A");
		expect(finished.board.actors.A["life-state"]).toBe("alive");
		expect(responsibilitySet(finished.board, "A").map((item) => item.id)).toEqual([holderTaskId]);
	});

	it("keeps an accepted attempt alive after the last token task is cancelled (T13)", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [tokenTask()],
		});
		const [tokenTaskId] = taskIds;
		const accepted = await run(
			board,
			{
				type: "acceptTake",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A hands off the parser notes",
			},
			{ actor: "A", requestId: "accept-A" },
		);
		expect(accepted.ok).toBe(true);
		expect(accepted.receipt.outcome).toBe("attempt-accepted");
		expect(accepted.board["take-attempts"]["accept-A"].resolved).toBe(false);

		const blocked = await run(
			accepted.board,
			{ type: "comment", taskId: tokenTaskId, text: "should not pass while pending" },
			{ actor: "A", requestId: "pending-comment" },
		);
		expect(blocked.ok).toBe(false);
		expect(blocked.error.code).toBe("INVALID_ARGUMENT");
		expect(blocked.error.data.requestId).toBe("accept-A");

		const cancelled = await run(
			accepted.board,
			{ type: "cancel", taskId: tokenTaskId, reason: "user cancelled the only token task" },
			{ actor: "B", turnId: "turn-2", requestId: "cancel-token" },
		);
		expect(cancelled.ok).toBe(true);
		expect(cancelled.board.tasks[tokenTaskId]).toBeUndefined();

		const resolved = await run(
			cancelled.board,
			{ type: "resolveTake", attemptId: "accept-A" },
			{ actor: "A", turnId: "turn-3", requestId: "resolve-A" },
		);
		expect(resolved.ok).toBe(true);
		expect(resolved.receipt.outcome).toBe("attempt-won");
		expect(resolved.receipt["holder-retired"]).toBeTruthy();
		expect(resolved.board["token-slot"]["holder-id"]).toBeNull();
		expect(resolved.board.actors.A["life-state"]).toBe("dead");
		expect(resolved.board["take-attempts"]["accept-A"].resolved).toBe(true);
		expect(resolved.board["take-attempts"]["accept-A"].outcome).toBe("attempt-won");

		const replay = await run(
			resolved.board,
			{ type: "resolveTake", attemptId: "accept-A" },
			{ actor: "A", turnId: "turn-3", requestId: "resolve-A" },
		);
		expect(replay.ok).toBe(true);
		expect(replay.replayed).toBe(true);
		expect(replay.receipt.outcome).toBe("attempt-won");
	});

	it("resolves two accepted attempts as exactly one win and one loss", async () => {
		const { board } = seedBoard({ actors: ["A", "B"], tasks: [tokenTask()] });
		const acceptedA = await run(
			board,
			{
				type: "acceptTake",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A hands off",
			},
			{ actor: "A", requestId: "accept-a" },
		);
		const acceptedB = await run(
			acceptedA.board,
			{
				type: "acceptTake",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "B hands off",
			},
			{ actor: "B", requestId: "accept-b" },
		);
		expect(acceptedB.ok).toBe(true);
		expect(acceptedB.board["token-slot"]["holder-id"]).toBeNull();

		const resolvedA = await run(
			acceptedB.board,
			{ type: "resolveTake", attemptId: "accept-a" },
			{ actor: "A", turnId: "turn-2", requestId: "resolve-a" },
		);
		expect(resolvedA.ok).toBe(true);
		expect(resolvedA.receipt.outcome).toBe("attempt-won");
		expect(resolvedA.receipt.lostAttempts.map((item) => item.attemptId)).toEqual(["accept-b"]);
		expect(resolvedA.board.actors.B["life-state"]).toBe("dead");
		expect(resolvedA.board["token-slot"]["holder-id"]).toBe("A");

		const resolvedB = await run(
			resolvedA.board,
			{ type: "resolveTake", attemptId: "accept-b" },
			{ actor: "B", turnId: "turn-3", requestId: "resolve-b" },
		);
		expect(resolvedB.ok).toBe(true);
		expect(resolvedB.receipt.outcome).toBe("attempt-lost");
	});

	it("reports token work added between acceptance and resolution", async () => {
		const { board } = seedBoard({ actors: ["A", "B"], tasks: [tokenTask("first")] });
		const accepted = await run(
			board,
			{
				type: "acceptTake",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A accepts the token",
			},
			{ actor: "A", requestId: "dynamic-accept" },
		);
		expect(accepted.ok).toBe(true);

		const added = await run(
			accepted.board,
			{ type: "addTasks", tasks: [tokenTask("second")] },
			{ actor: "B", requestId: "dynamic-add" },
		);
		expect(added.ok).toBe(true);
		const secondTaskId = added.receipt.taskIds[0];

		const resolved = await run(
			added.board,
			{ type: "resolveTake", attemptId: "dynamic-accept" },
			{ actor: "A", turnId: "turn-2", requestId: "dynamic-resolve" },
		);
		expect(resolved.ok).toBe(true);
		expect(resolved.receipt.outcome).toBe("attempt-won");
		expect(resolved.receipt.tokenTasks).toEqual(expect.arrayContaining(["T-1", secondTaskId]));
		expect(responsibilitySet(resolved.board, "A").map((item) => item.id)).toEqual(
			expect.arrayContaining(["T-1", secondTaskId]),
		);
	});

	it("hands a losing actor's waiting parent to the public pool and revives it later", async () => {
		const board = seedBoard({
			actors: ["A", "B", "C"],
			tasks: [
				tokenTask(),
				{ goal: "parent", remainingWork: "integration", doneWhen: "done", needsToken: false },
				{ goal: "child", remainingWork: "work", doneWhen: "done", needsToken: false },
			],
		}).board;
		const tokenTaskId = "T-1";
		const parentId = "T-2";
		const childId = "T-3";
		board.tasks[parentId]["owner-id"] = "B";
		board.tasks[parentId].state = "waiting";
		board.tasks[parentId]["wait-for"] = [childId];
		board.tasks[parentId]["child-ids"] = [childId];
		board.tasks[childId]["parent-id"] = parentId;

		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes checks",
			},
			{ actor: "A", requestId: "handoff-win" },
		);
		const loss = await run(
			win.board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "B hands off the parent integration",
			},
			{ actor: "B", requestId: "handoff-loss" },
		);
		expect(loss.ok).toBe(true);
		const handedParent = loss.board.tasks[parentId];
		expect(handedParent["owner-id"]).toBeNull();
		expect(handedParent["handoff-note"]).toBe("B hands off the parent integration");
		expect(handedParent["wait-for"]).toEqual([childId]);
		expect(handedParent.state).toBe("waiting");

		const lateFinish = await run(
			loss.board,
			{
				type: "finish",
				taskId: parentId,
				claimId: "C-999",
				resultSummary: "late finish from a dead actor",
				dependencyPaths: [],
			},
			{ actor: "B", requestId: "late-finish" },
		);
		expect(lateFinish.ok).toBe(false);
		expect(lateFinish.error.code).toBe("ACTOR_DEAD");
		expect(lateFinish.board.tasks[parentId]["owner-id"]).toBeNull();
		expect(lateFinish.board.tasks[parentId].state).toBe("waiting");

		const childClaim = await claimTask(loss.board, childId, "C");
		const childFinish = await finishTask(childClaim.board, childId, "C", childClaim.receipt.claimId, {
			turnId: "turn-3",
		});
		expect(childFinish.board.tasks[parentId].state).toBe("ready");
		expect(childFinish.board.tasks[parentId]["owner-id"]).toBeNull();

		const parentClaim = await claimTask(childFinish.board, parentId, "C");
		expect(parentClaim.ok).toBe(true);
		expect(parentClaim.board.tasks[parentId]["owner-id"]).toBe("C");
		expect(tokenTaskId).toBe("T-1");
	});
});

describe("board kernel: parking and wake", () => {
	it("rejects parking while a ready task exists and returns the progressable summary", async () => {
		const { board } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const parked = await run(board, {
			type: "parkSlot",
			observedBoardVersion: 0,
		});
		expect(parked.ok).toBe(false);
		expect(parked.error.code).toBe("BOARD_CONFLICT");
		expect(parked.error.data.summary.progressable.length).toBe(1);
		expect(parked.board.sleepers).toEqual({});
	});

	it("rejects parking while only Holder token work remains", async () => {
		const { board } = seedBoard({ actors: ["A", "B"], tasks: [tokenTask()] });
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes checks",
			},
			{ actor: "A", requestId: "park-holder-take" },
		);
		const parked = await run(
			win.board,
			{ type: "parkSlot", observedBoardVersion: win.board["board-version"] },
			{ actor: "B", requestId: "park-holder" },
		);
		expect(parked.ok).toBe(false);
		expect(parked.error.code).toBe("BOARD_CONFLICT");
		expect(parked.error.data.summary.progressable.length).toBe(1);
		expect(parked.error.data.summary["holder-id"]).toBe("A");
	});

	it("parks on a truly empty board and wakes on new work in version order", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B", "C"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;
		const claim = await claimTask(board, taskId, "B");
		const action = await run(
			claim.board,
			{
				type: "startAction",
				taskId,
				claimId: claim.receipt.claimId,
				kind: "edit",
				phase: "applying",
			},
			{ actor: "B", requestId: "park-action" },
		);
		expect(action.ok).toBe(true);
		expect(progressableSet(action.board)).toEqual([]);

		const parked = await run(
			action.board,
			{ type: "parkSlot", observedBoardVersion: action.board["board-version"] },
			{ actor: "A", requestId: "park-empty" },
		);
		expect(parked.ok).toBe(true);
		expect(parked.receipt.outcome).toBe("parked");
		expect(parked.board.sleepers.A).toBeTruthy();
		expect(parked.board.wake.epoch).toBe(0);

		const added = await run(
			parked.board,
			{
				type: "addTasks",
				tasks: [{ goal: "new work", remainingWork: "new work", doneWhen: "done", needsToken: false }],
			},
			{ actor: "C", requestId: "park-new-work" },
		);
		expect(added.ok).toBe(true);
		expect(added.board.sleepers).toEqual({});
		expect(added.board.wake.epoch).toBe(1);
		expect(added.events.map((event) => event["event-type"])).toContain("wake-all");
	});

	it("wakes sleepers when an applying action finishes and work becomes progressable", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;
		const claim = await claimTask(board, taskId, "B");
		const action = await run(
			claim.board,
			{
				type: "startAction",
				taskId,
				claimId: claim.receipt.claimId,
				kind: "edit",
				phase: "applying",
			},
			{ actor: "B", requestId: "wake-action-start" },
		);
		const parked = await run(
			action.board,
			{ type: "parkSlot", observedBoardVersion: action.board["board-version"] },
			{ actor: "A", requestId: "wake-action-park" },
		);
		expect(parked.ok).toBe(true);
		expect(parked.board.sleepers.A).toBeTruthy();

		const finished = await run(
			parked.board,
			{ type: "setActionPhase", actionId: action.receipt.actionId, phase: "finished" },
			{ actor: "B", requestId: "wake-action-finish" },
		);
		expect(finished.ok).toBe(true);
		expect(finished.board.sleepers).toEqual({});
		expect(finished.board.wake.epoch).toBe(1);
		expect(finished.events.map((event) => event["event-type"])).toContain("wake-all");
	});

	it("wakes sleepers when a condition revives a waiting parent", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [
				{
					goal: "gate parent",
					remainingWork: "integrate after the gate",
					doneWhen: "integrated",
					needsToken: false,
					ownerId: "A",
				},
			],
		});
		const [parentId] = taskIds;
		const waiting = structuredClone(board);
		waiting.tasks[parentId].state = "waiting";
		waiting.tasks[parentId]["wait-for"] = ["condition:gate-open"];

		const parked = await run(
			waiting,
			{ type: "parkSlot", observedBoardVersion: waiting["board-version"] },
			{ actor: "A", requestId: "condition-park" },
		);
		expect(parked.ok).toBe(true);
		expect(parked.board.sleepers.A).toBeTruthy();

		const resolved = await run(
			parked.board,
			{ type: "resolveCondition", key: "gate-open", value: true },
			{ actor: "B", turnId: "turn-2", requestId: "condition-resolve" },
		);
		expect(resolved.ok).toBe(true);
		expect(resolved.board.tasks[parentId].state).toBe("ready");
		expect(resolved.board.sleepers).toEqual({});
		expect(resolved.board.wake.epoch).toBe(1);
		expect(resolved.events.map((event) => event["event-type"])).toContain("wake-all");
	});

	it("rejects a stale observed_board_version and keeps the sleeper list empty", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A", "B"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const advanced = await run(
			board,
			{ type: "comment", taskId: taskIds[0], text: "advance the board version" },
			{ actor: "A", requestId: "stale-advance" },
		);
		const parked = await run(
			advanced.board,
			{ type: "parkSlot", observedBoardVersion: 0 },
			{ actor: "B", requestId: "stale-park" },
		);
		expect(parked.ok).toBe(false);
		expect(parked.error.code).toBe("BOARD_CONFLICT");
		expect(parked.error.data.current).toBe(1);
		expect(parked.board.sleepers).toEqual({});
	});

	it("records raw user input and forces wake-all", async () => {
		const { board } = seedBoard({ actors: ["A"] });
		const recorded = await run(
			board,
			{ type: "recordInput", text: "please keep the old configuration format" },
			{ turnId: "user-turn", requestId: "user-input-1" },
		);
		expect(recorded.ok).toBe(true);
		expect(recorded.board.inputs.length).toBe(1);
		expect(recorded.board.inputs[0].text).toBe("please keep the old configuration format");
		expect(recorded.board.wake.epoch).toBe(1);
		const eventTypes = recorded.events.map((event) => event["event-type"]);
		expect(eventTypes).toContain("user-input");
		expect(eventTypes).toContain("wake-all");
	});
});

describe("board kernel: reopen, update and comments", () => {
	it("reopens a done task with reason and evidence and wakes sleepers", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;
		const claim = await claimTask(board, taskId, "A");
		const done = await finishTask(claim.board, taskId, "A", claim.receipt.claimId);
		expect(done.board.tasks[taskId].state).toBe("done");

		const missingEvidence = await run(done.board, {
			type: "reopen",
			taskId,
			reason: "acceptance failed",
		});
		expect(missingEvidence.ok).toBe(false);
		expect(missingEvidence.error.code).toBe("INVALID_ARGUMENT");

		const reopened = await run(done.board, {
			type: "reopen",
			taskId,
			reason: "acceptance failed",
			evidence: ["plans/demo/evidence/CASE-01/report.md"],
		});
		expect(reopened.ok).toBe(true);
		expect(reopened.board.tasks[taskId].state).toBe("ready");
		expect(reopened.board.tasks[taskId]["claim-id"]).toBeNull();
		expect(reopened.board.wake.epoch).toBe(1);
	});

	it("updates only allowed fields and recomputes token responsibility", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false, ownerId: "A" }],
		});
		const [taskId] = taskIds;
		const updated = await run(board, {
			type: "update",
			taskId,
			fields: {
				goal: "revised",
				remainingWork: "revised work",
				doneWhen: "revised done",
				needsToken: true,
			},
		});
		expect(updated.ok).toBe(true);
		const task = updated.board.tasks[taskId];
		expect(task.goal).toBe("revised");
		expect(task["remaining-work"]).toBe("revised work");
		expect(task["done-when"]).toBe("revised done");
		expect(task["needs-token"]).toBe(true);

		const win = await run(
			updated.board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the revised check",
			},
			{ actor: "A", requestId: "update-take" },
		);
		expect(win.ok).toBe(true);
		expect(responsibilitySet(win.board, "A").some((item) => item.id === taskId)).toBe(true);

		const badField = await run(updated.board, {
			type: "update",
			taskId,
			fields: { priority: "high" },
		});
		expect(badField.ok).toBe(false);
		expect(badField.error.code).toBe("INVALID_ARGUMENT");
	});

	it("adds comments without changing task state", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const [taskId] = taskIds;
		const comment = await run(board, {
			type: "comment",
			taskId,
			text: "observed a useful split",
		});
		expect(comment.ok).toBe(true);
		expect(comment.board.tasks[taskId].state).toBe("ready");
		expect(comment.board.tasks[taskId].comments.length).toBe(1);
		expect(comment.board.tasks[taskId].comments[0].text).toBe("observed a useful split");

		const empty = await run(comment.board, { type: "comment", taskId, text: "" });
		expect(empty.ok).toBe(false);
		expect(empty.error.code).toBe("INVALID_ARGUMENT");
	});
});

describe("board kernel: actions, write gate and storage boundary", () => {
	it("runs a write gate action and rejects a stale claim as STALE_CONTROL", async () => {
		let board = seedBoard({ actors: ["A"], tasks: [tokenTask()] }).board;
		const taskId = "T-1";
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the write",
			},
			{ actor: "A", requestId: "gate-take" },
		);
		const claim = await claimTask(win.board, taskId, "A");
		board = claim.board;

		const store = createMemoryBoardStore({ initial: board });
		const handle = openBoard("/tmp/herd-board-test", "slug", "slice-1", { store });
		const control = createWriteGateControl(handle);

		const stale = bareError(
			await control.markApplying({
				taskId,
				claimId: "C-999",
				kind: "edit",
				actor: "A",
				turnId: "turn-gate",
				requestId: "gate-stale",
			}),
		);
		expect(stale.ok).toBe(false);
		expect(stale.error.code).toBe("STALE_CONTROL");

		const applying = await control.markApplying({
			taskId,
			claimId: claim.receipt.claimId,
			kind: "edit",
			actor: "A",
			turnId: "turn-gate",
			requestId: "gate-applying",
		});
		expect(applying.ok).toBe(true);
		const actionId = applying.receipt.actionId;
		expect(store.snapshot().actions[actionId].phase).toBe("applying");
		expect(responsibilitySet(store.snapshot(), "A").some((item) => item.kind === "action")).toBe(true);

		const prematureFinish = await finishTask(store.snapshot(), taskId, "A", claim.receipt.claimId, {
			turnId: "turn-gate-1",
		});
		expect(prematureFinish.ok).toBe(false);
		expect(prematureFinish.error.code).toBe("TASK_NOT_READY");

		const published = await control.publishResult({
			actionId,
			status: "applied",
			claimId: claim.receipt.claimId,
			actor: "A",
			turnId: "turn-gate",
			requestId: "gate-published",
		});
		expect(published.ok).toBe(true);
		expect(store.snapshot().actions[actionId].phase).toBe("finished");

		const finish = await finishTask(store.snapshot(), taskId, "A", claim.receipt.claimId, { turnId: "turn-gate-2" });
		expect(finish.ok).toBe(true);
	});

	it("allocates applying actions and registers running actions for VFS", async () => {
		const { board } = seedBoard({ actors: ["A"], tasks: [tokenTask()] });
		const win = await run(
			board,
			{
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A takes the write",
			},
			{ actor: "A", requestId: "vfs-take" },
		);
		const claim = await claimTask(win.board, "T-1", "A");
		const store = createMemoryBoardStore({ initial: claim.board });
		const handle = openBoard("/tmp/herd-vfs-control", "slug", "vfs", { store });
		const control = createWriteGateControl(handle);
		const identity = { agent_id: "A" };
		const claimRef = { claim_id: claim.receipt.claimId, task_id: "T-1" };

		const applying = await control.markApplying({
			identity,
			claim: claimRef,
			kind: ":edit",
			batchId: "batch-1",
		});
		expect(applying.ok).toBe(true);
		expect(typeof applying.actionId).toBe("string");
		expect(store.snapshot().actions[applying.actionId].phase).toBe("applying");

		const publishedEdit = await control.publishResult({
			actionId: applying.actionId,
			status: ":applied",
			identity,
			claim: claimRef,
		});
		expect(publishedEdit.ok).toBe(true);
		expect(store.snapshot().actions[applying.actionId].phase).toBe("finished");

		const running = await control.markRunning({
			actionId: "run-1",
			command: "echo ok",
			cwd: "/tmp",
			identity,
			claim: claimRef,
		});
		expect(running.ok).toBe(true);
		expect(running.actionId).toBe("run-1");
		expect(store.snapshot().actions["run-1"].kind).toBe("shell");
		expect(store.snapshot().actions["run-1"].phase).toBe("running");

		const publishedRun = await control.publishResult({
			actionId: "run-1",
			status: ":applied",
			identity,
			claim: claimRef,
		});
		expect(publishedRun.ok).toBe(true);
		expect(store.snapshot().actions["run-1"].phase).toBe("finished");

		const missingTask = await control.markRunning({
			actionId: "run-missing",
			identity,
		});
		expect(missingTask.ok).toBe(false);
		expect(store.snapshot().actions["run-missing"]).toBeUndefined();
	});

	it("resolves a condition wait and applies the same-turn parent guard", async () => {
		const { board, taskIds } = seedBoard({
			actors: ["A"],
			tasks: [
				{
					goal: "gate parent",
					remainingWork: "integrate after the gate",
					doneWhen: "integrated",
					needsToken: false,
					ownerId: "A",
				},
			],
		});
		const [parentId] = taskIds;
		const waiting = structuredClone(board);
		waiting.tasks[parentId].state = "waiting";
		waiting.tasks[parentId]["wait-for"] = ["condition:oracle:gate-open"];

		const invalid = await run(
			waiting,
			{ type: "resolveCondition", key: "oracle:gate-open", value: null },
			{ actor: "A", requestId: "condition-null" },
		);
		expect(invalid.ok).toBe(false);
		expect(invalid.error.code).toBe("INVALID_ARGUMENT");
		expect(invalid.board.conditions["oracle:gate-open"]).toBeUndefined();
		expect(invalid.board.tasks[parentId].state).toBe("waiting");

		const resolved = await run(
			waiting,
			{ type: "resolveCondition", key: "oracle:gate-open", value: true },
			{ actor: "A", turnId: "turn-4" },
		);
		expect(resolved.ok).toBe(true);
		expect(resolved.board.conditions["oracle:gate-open"]).toBe(true);
		expect(resolved.board.tasks[parentId].state).toBe("ready");
		expect(resolved.board.tasks[parentId]["wait-for"]).toEqual([]);

		const claim = await claimTask(resolved.board, parentId, "A", { turnId: "turn-4" });
		const sameTurn = await finishTask(claim.board, parentId, "A", claim.receipt.claimId, { turnId: "turn-4" });
		expect(sameTurn.ok).toBe(false);
		expect(sameTurn.error.code).toBe("PARENT_NOT_READY");
	});

	it("keeps memory store transactions serial and does not expose its live state", async () => {
		const store = createMemoryBoardStore({
			initial: seedBoard({ actors: ["A"] }).board,
		});
		const first = store.transaction(async (current) => {
			const next = structuredClone(current);
			next["board-version"] += 1;
			return { board: next, events: [], response: next["board-version"], commit: true };
		});
		const second = store.transaction(async (current) => {
			return { board: current, events: [], response: current["board-version"], commit: true };
		});
		expect(await first).toBe(1);
		expect(await second).toBe(1);
		const snapshot = store.snapshot();
		snapshot["board-version"] = 99;
		expect(store.snapshot()["board-version"]).toBe(1);
	});

	it("opens a board handle, reads through the store and commits commands", async () => {
		const store = createMemoryBoardStore({ initial: initialBoard() });
		const handle = openBoard("/tmp/herd-board-open", "slug", "slice-2", { store });
		expect(await readBoard(handle)).toEqual(initialBoard());

		const registered = await apply({
			board: handle,
			command: { type: "registerActor", agentId: "D", slotId: "slot-D" },
			turnId: "turn-register",
			requestId: "handle-register",
		});
		expect(registered.ok).toBe(true);
		const current = await readBoard(handle);
		expect(current.actors.D["life-state"]).toBe("alive");
		expect(current["board-version"]).toBe(1);
		expect(current.requests["handle-register"].receipt.outcome).toBe("actor-registered");
	});

	it("returns U0 HerdError values with keyword codes", async () => {
		const { board } = seedBoard({
			actors: ["A"],
			tasks: [{ goal: "one", remainingWork: "one", doneWhen: "one", needsToken: false }],
		});
		const result = await apply({
			board,
			command: { type: "claim", taskId: "T-999", atomicityReason: "one result" },
			actor: "A",
			turnId: "turn-error",
			requestId: "herd-error",
		});
		expect(result.ok).toBe(false);
		expect(isHerdError(result.error)).toBe(true);
		expect(result.error.code).toBe(":INVALID_ARGUMENT");
		expect(result.error.data.taskId).toBe("T-999");
	});

	it("supports explicit wakeAll without inventing work", () => {
		const { board } = seedBoard({ actors: ["A"] });
		const woken = wakeAll(board, "user-input");
		expect(woken.epoch).toBe(1);
		expect(woken.board.wake.epoch).toBe(1);
		expect(woken.event["event-type"]).toBe("wake-all");
		expect(woken.board["board-version"]).toBe(1);
		expect(woken.board.tasks).toEqual(board.tasks);
	});
});

describe("board kernel: plan review ledger", () => {
	it("starts a plan board attach-ready and review-quiescent", () => {
		const board = initialBoard({ mode: "plan" });
		expect(board.mode).toBe("plan");
		expect(board.tasks).toEqual({});
		expect(board["attach-ready"]).toBe(true);
		expect(board["review-summary"]).toBeNull();
		expect(board.tenure).toEqual({ term: 0, phase: "plan" });
		expect(isAttachReady(board)).toBe(true);
		expect(reviewLedger(board)).toEqual({
			summary: null,
			findings: [],
			empty: true,
			attachReady: true,
		});
	});

	it("upserts findings and preserves plan structure keys", () => {
		const started = initialBoard({ mode: "plan" });
		const parent = applyReview(started, {
			findings: [{ key: "gate", value: "the gate closes" }],
		});
		expect(parent.ok).toBe(true);
		expect(parent.changed).toBe(true);
		expect(parent.receipt.outcome).toBe("review-recorded");
		expect(parent.receipt["board-version"]).toBe(1);
		expect(parent.board.tasks.gate).toEqual({
			key: "gate",
			value: "the gate closes",
			"parent-key": null,
			"child-keys": [],
			"wait-for": [],
			waiting: false,
		});
		expect(isAttachReady(parent.board)).toBe(false);

		const child = applyReview(parent.board, {
			findings: [
				{
					key: "parser",
					value: "parse the new syntax",
					parentKey: "gate",
					waitFor: ["gate"],
					waiting: true,
				},
			],
		});
		expect(child.ok).toBe(true);
		expect(child.board.tasks.gate["child-keys"]).toEqual(["parser"]);
		expect(child.board.tasks.parser).toEqual({
			key: "parser",
			value: "parse the new syntax",
			"parent-key": "gate",
			"child-keys": [],
			"wait-for": ["gate"],
			waiting: true,
		});

		const updated = applyReview(child.board, {
			findings: [{ key: "parser", value: "parse the new syntax and the old one" }],
		});
		expect(updated.ok).toBe(true);
		expect(updated.board.tasks.parser).toEqual({
			key: "parser",
			value: "parse the new syntax and the old one",
			"parent-key": "gate",
			"child-keys": [],
			"wait-for": ["gate"],
			waiting: true,
		});
		expect(updated.board.tasks.gate["child-keys"]).toEqual(["parser"]);
	});

	it("deletes on nil, skips an array value and leaves empty findings alone", () => {
		const board = initialBoard({ mode: "plan" });
		const seeded = applyReview(board, {
			summary_markdown: "first round",
			findings: [
				{ key: "one", value: "first" },
				{ key: "two", value: "second" },
			],
		});
		expect(seeded.ok).toBe(true);
		expect(seeded.board["review-summary"]).toBe("first round");

		const skipped = applyReview(seeded.board, {
			findings: [{ key: "one", value: [] }],
		});
		expect(skipped.ok).toBe(true);
		expect(skipped.changed).toBe(false);
		expect(skipped.receipt.outcome).toBe("review-unchanged");
		expect(skipped.board.tasks).toEqual(seeded.board.tasks);

		const untouched = applyReview(seeded.board, { findings: [] });
		expect(untouched.ok).toBe(true);
		expect(untouched.changed).toBe(false);
		expect(untouched.receipt.outcome).toBe("review-unchanged");
		expect(untouched.board.tasks).toEqual(seeded.board.tasks);

		const removed = applyReview(seeded.board, {
			findings: [{ key: "one", value: null }],
		});
		expect(removed.ok).toBe(true);
		expect(removed.changed).toBe(true);
		expect(removed.board.tasks.one).toBeUndefined();
		expect(removed.board.tasks.two.value).toBe("second");
		expect(removed.board["review-summary"]).toBe("first round");
	});

	it("writes and clears the review summary without touching tasks", () => {
		const board = initialBoard({ mode: "plan" });
		const withFinding = applyReview(board, {
			findings: [{ key: "one", value: "first" }],
		});
		const written = applyReview(withFinding.board, {
			summary_markdown: "round one",
		});
		expect(written.ok).toBe(true);
		expect(written.board["review-summary"]).toBe("round one");
		expect(written.board.tasks).toEqual(withFinding.board.tasks);
		expect(written.receipt["board-version"]).toBe(2);

		const cleared = applyReview(written.board, { summary_markdown: null });
		expect(cleared.ok).toBe(true);
		expect(cleared.board["review-summary"]).toBeNull();
		expect(cleared.board.tasks).toEqual(written.board.tasks);
		expect(cleared.receipt.outcome).toBe("review-recorded");
	});

	it("returns to attach-ready only when the ledger is empty", () => {
		const board = initialBoard({ mode: "plan" });
		const seeded = applyReview(board, {
			findings: [
				{ key: "one", value: "first" },
				{ key: "two", value: "second", parentKey: "one" },
			],
		});
		expect(isAttachReady(seeded.board)).toBe(false);
		expect(reviewLedger(seeded.board)).toMatchObject({ empty: false, attachReady: false });

		const emptied = applyReview(seeded.board, {
			findings: [
				{ key: "one", value: null },
				{ key: "two", value: null },
			],
		});
		expect(emptied.ok).toBe(true);
		expect(emptied.board.tasks).toEqual({});
		expect(emptied.board["attach-ready"]).toBe(true);
		expect(isAttachReady(emptied.board)).toBe(true);
		expect(reviewLedger(emptied.board)).toEqual({
			summary: null,
			findings: [],
			empty: true,
			attachReady: true,
		});

		const quiet = applyReview(emptied.board, { findings: [] });
		expect(quiet.changed).toBe(false);
		expect(quiet.receipt.outcome).toBe("review-unchanged");
	});

	it("opens plan mode at the mission root with no board lock", () => {
		const root = tempRoot();
		const handle = openBoard(root, "demo");
		expect(handle.mode).toBe("plan");
		expect(handle.sliceId).toBeNull();
		expect(handle.boardPath).toBe(join(root, ".herd", "missions", "demo", "board.edn"));
		expect(handle.eventsPath).toBe(join(root, ".herd", "missions", "demo", "events.jsonl"));
		expect(handle.checkpointPath).toBe(join(root, ".herd", "missions", "demo", "checkpoint.edn"));
		expect(handle.lockPath).toBeNull();
		expect(handle.durable).toBe(true);

		const explicit = openBoard(root, "demo", { mode: "plan" });
		expect(explicit.mode).toBe("plan");
		expect(explicit.boardPath).toBe(handle.boardPath);
		expect(explicit.lockPath).toBeNull();
	});

	it("persists a review through the file store without a request or turn", async () => {
		const root = tempRoot();
		const handle = await seededPlanBoard(root, "demo");

		const result = await apply({
			board: handle,
			command: {
				type: "review",
				summary_markdown: "attach after findings close",
				findings: [
					{ key: "gate", value: "the gate closes" },
					{ key: "parser", value: "parse the new syntax", parentKey: "gate" },
				],
			},
		});
		expect(result.ok).toBe(true);
		expect(result.receipt.outcome).toBe("review-recorded");

		const reopened = openBoard(root, "demo");
		const persisted = await readBoard(reopened);
		expect(persisted.mode).toBe("plan");
		expect(persisted["review-summary"]).toBe("attach after findings close");
		expect(persisted.tasks.gate["child-keys"]).toEqual(["parser"]);
		expect(persisted.tasks.parser["parent-key"]).toBe("gate");
		expect(persisted["attach-ready"]).toBe(false);
		expect(persisted.tenure).toEqual({ term: 0, phase: "plan" });

		const eventTypes = readFileSync(handle.eventsPath, "utf8")
			.trim()
			.split("\n")
			.map((line) => JSON.parse(line)["event-type"]);
		expect(eventTypes).toContain("review");

		const closed = await apply({
			board: reopened,
			command: {
				type: "review",
				findings: [
					{ key: "gate", value: null },
					{ key: "parser", value: null },
				],
			},
		});
		expect(closed.ok).toBe(true);
		expect(closed.board["attach-ready"]).toBe(true);
		expect(closed.board.tenure).toEqual({ term: 0, phase: "plan" });

		const reread = await readBoard(openBoard(root, "demo"));
		expect(reread.tasks).toEqual({});
		expect(reread.tenure.phase).toBe("plan");
	});
});

describe("board kernel: durable file store", () => {
	it("never silently creates a missing production board", async () => {
		const root = tempRoot();
		const handle = openBoard(root, "demo", "s1");
		expect(handle.durable).toBe(true);
		expect(await readBoard(handle)).toBeNull();

		const result = await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-missing",
			requestId: "missing-board",
		});
		expect(result.ok).toBe(false);
		expect(isHerdError(result.error)).toBe(true);
		expect(result.error.code).toBe(":STALE_CONTROL");
		expect(existsSync(handle.boardPath)).toBe(false);
	});

	it("commits the EDN board, JSONL events and checkpoint, then re-reads them", async () => {
		const root = tempRoot();
		const handle = await seededFileBoard(root, "demo", "s2");
		const registered = await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "file-register",
		});
		expect(registered.ok).toBe(true);

		const goal = '第一行 "quoted"\nsecond line';
		const added = await apply({
			board: handle,
			command: {
				type: "addTasks",
				tasks: [
					{
						goal,
						remainingWork: "run the command and record the result",
						doneWhen: "result recorded",
						needsToken: false,
					},
					{
						goal: ":literal user text",
						remainingWork: "keep the colon",
						doneWhen: "colon preserved",
						needsToken: false,
					},
				],
			},
			actor: "A",
			turnId: "turn-1",
			requestId: "file-add",
		});
		expect(added.ok).toBe(true);

		const boardText = readFileSync(handle.boardPath, "utf8");
		expect(boardText).toContain(":state :ready");
		expect(boardText).toContain(":life-state :alive");
		expect(boardText).toContain(":goal");

		const state = await readBoard(handle);
		expect(state["board-version"]).toBe(2);
		expect(state.tasks["T-1"].goal).toBe(goal);
		expect(state.tasks["T-2"].goal).toBe(":literal user text");
		expect(state.actors.A["life-state"]).toBe("alive");

		const lines = readFileSync(handle.eventsPath, "utf8")
			.trim()
			.split("\n")
			.map((line) => JSON.parse(line));
		const eventTypes = lines.map((entry) => entry["event-type"]);
		expect(eventTypes).toContain("actor-registered");
		expect(eventTypes).toContain("tasks-added");
		const eventSize = statSync(handle.eventsPath).size;
		const checkpoint = readFileSync(handle.checkpointPath, "utf8");
		expect(checkpoint).toContain(`:offset ${eventSize}`);
		expect(checkpoint).toMatch(/:digest "[0-9a-f]{64}"/);

		const reopened = openBoard(root, "demo", "s2");
		expect(await readBoard(reopened)).toEqual(state);
	});

	it("preserves an uppercase plan slug through paths and reads", async () => {
		const root = tempRoot();
		const slug = "DEMO-01";
		const handle = await seededPlanBoard(root, slug);
		expect(handle.slug).toBe(slug);
		expect(handle.mode).toBe("plan");
		expect(handle.sliceId).toBeNull();
		expect(handle.boardPath).toBe(join(root, ".herd", "missions", slug, "board.edn"));
		expect(handle.eventsPath).toBe(join(root, ".herd", "missions", slug, "events.jsonl"));
		expect(handle.checkpointPath).toBe(join(root, ".herd", "missions", slug, "checkpoint.edn"));
		expect(handle.lockPath).toBeNull();

		const reviewed = await apply({
			board: handle,
			command: {
				type: "review",
				findings: [{ key: "gate", value: "the gate closes" }],
			},
		});
		expect(reviewed.ok).toBe(true);

		const reopened = openBoard(root, slug);
		const state = await readBoard(reopened);
		expect(state["board-version"]).toBe(1);
		expect(state.tasks.gate.value).toBe("the gate closes");
		expect(state.tenure.phase).toBe("plan");
		expect(openBoard(root, slug.toLowerCase()).boardPath).not.toBe(handle.boardPath);
	});

	it("serializes concurrent token races through the real board lock", async () => {
		const root = tempRoot();
		const handle = await seededFileBoard(root, "demo", "s3");
		expect(
			(
				await apply({
					board: handle,
					command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
					turnId: "turn-1",
					requestId: "race-register-A",
				})
			).ok,
		).toBe(true);
		expect(
			(
				await apply({
					board: handle,
					command: { type: "registerActor", agentId: "B", slotId: "slot-B" },
					turnId: "turn-1",
					requestId: "race-register-B",
				})
			).ok,
		).toBe(true);
		expect(
			(
				await apply({
					board: handle,
					command: { type: "addTasks", tasks: [tokenTask()] },
					actor: "A",
					turnId: "turn-1",
					requestId: "race-add",
				})
			).ok,
		).toBe(true);

		const take = (actor, id) =>
			apply({
				board: handle,
				command: {
					type: "takeOrDie",
					confirm: TAKE_OR_DIE_CONFIRMATION,
					handoffMarkdown: `${actor} hands off`,
				},
				actor,
				turnId: "turn-2",
				requestId: id,
			});
		const [first, second] = await Promise.all([take("A", "race-take-A"), take("B", "race-take-B")]);
		const outcomes = [first.receipt?.outcome, second.receipt?.outcome].sort();
		expect(outcomes).toEqual(["attempt-lost", "attempt-won"]);

		const state = await readBoard(handle);
		const holderId = state["token-slot"]["holder-id"];
		expect(["A", "B"]).toContain(holderId);
		const loserId = holderId === "A" ? "B" : "A";
		expect(state.actors[loserId]["life-state"]).toBe("dead");
		const attempts = Object.values(state["take-attempts"]);
		expect(attempts.length).toBe(2);
		expect(attempts.every((attempt) => attempt.resolved === true)).toBe(true);
	});

	it("uses the two-phase take path for a production handle", async () => {
		const root = tempRoot();
		const handle = await seededFileBoard(root, "demo", "s3b");
		await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "two-phase-register",
		});
		await apply({
			board: handle,
			command: { type: "addTasks", tasks: [tokenTask()] },
			actor: "A",
			turnId: "turn-1",
			requestId: "two-phase-add",
		});

		const result = await apply({
			board: handle,
			command: {
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A hands off",
			},
			actor: "A",
			turnId: "turn-2",
			requestId: "two-phase-take",
		});
		expect(result.ok).toBe(true);
		expect(result.receipt.outcome).toBe("attempt-won");

		const state = await readBoard(handle);
		const attempt = state["take-attempts"]["two-phase-take:accept"];
		expect(attempt).toBeTruthy();
		expect(attempt.resolved).toBe(true);
		expect(attempt.outcome).toBe("attempt-won");
		const eventTypes = readFileSync(handle.eventsPath, "utf8")
			.trim()
			.split("\n")
			.map((line) => JSON.parse(line)["event-type"]);
		expect(eventTypes).toContain("token-attempt-accepted");
		expect(eventTypes).toContain("token-won");
	});

	it("persists an accepted attempt across cancellation and a fresh re-read (T13)", async () => {
		const root = tempRoot();
		const handle = await seededFileBoard(root, "demo", "s6");
		await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "file-t13-register-A",
		});
		await apply({
			board: handle,
			command: { type: "registerActor", agentId: "B", slotId: "slot-B" },
			turnId: "turn-1",
			requestId: "file-t13-register-B",
		});
		await apply({
			board: handle,
			command: { type: "addTasks", tasks: [tokenTask()] },
			actor: "A",
			turnId: "turn-1",
			requestId: "file-t13-add",
		});

		const accepted = await apply({
			board: handle,
			command: {
				type: "acceptTake",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A hands off the parser notes",
			},
			actor: "A",
			turnId: "turn-2",
			requestId: "file-accept-A",
		});
		expect(accepted.ok).toBe(true);

		const cancelled = await apply({
			board: handle,
			command: { type: "cancel", taskId: "T-1", reason: "user cancelled the token task" },
			actor: "B",
			turnId: "turn-3",
			requestId: "file-cancel-token",
		});
		expect(cancelled.ok).toBe(true);

		const reopened = openBoard(root, "demo", "s6");
		const beforeResolve = await readBoard(reopened);
		expect(beforeResolve.tasks["T-1"]).toBeUndefined();
		expect(beforeResolve["take-attempts"]["file-accept-A"].resolved).toBe(false);

		const resolved = await apply({
			board: reopened,
			command: { type: "resolveTake", attemptId: "file-accept-A" },
			actor: "A",
			turnId: "turn-4",
			requestId: "file-resolve-A",
		});
		expect(resolved.ok).toBe(true);
		expect(resolved.receipt.outcome).toBe("attempt-won");

		const persisted = await readBoard(openBoard(root, "demo", "s6"));
		expect(persisted["token-slot"]["holder-id"]).toBeNull();
		expect(persisted.actors.A["life-state"]).toBe("dead");
		expect(persisted["take-attempts"]["file-accept-A"].resolved).toBe(true);
		expect(persisted["take-attempts"]["file-accept-A"].outcome).toBe("attempt-won");
	});

	it("replays a completed take across a fresh handle without a second term", async () => {
		const root = tempRoot();
		const sliceId = "s6b";
		const handle = await seededFileBoard(root, "demo", sliceId);
		await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "replay-take-register",
		});
		await apply({
			board: handle,
			command: { type: "addTasks", tasks: [tokenTask()] },
			actor: "A",
			turnId: "turn-1",
			requestId: "replay-take-add",
		});
		const command = {
			type: "takeOrDie",
			confirm: TAKE_OR_DIE_CONFIRMATION,
			handoffMarkdown: "A hands off",
		};
		const first = await apply({
			board: handle,
			command,
			actor: "A",
			turnId: "turn-2",
			requestId: "replay-take",
		});
		expect(first.ok).toBe(true);
		expect(first.receipt.outcome).toBe("attempt-won");
		const termId = first.receipt.termId;
		const before = await readBoard(handle);

		const reopened = openBoard(root, "demo", sliceId);
		const replay = await apply({
			board: reopened,
			command,
			actor: "A",
			turnId: "turn-2",
			requestId: "replay-take",
		});
		expect(replay.ok).toBe(true);
		expect(replay.replayed).toBe(true);
		expect(replay.receipt.termId).toBe(termId);
		const after = await readBoard(reopened);
		expect(after["board-version"]).toBe(before["board-version"]);
		expect(after["token-slot"]["term-id"]).toBe(termId);
		expect(after["token-slot"]["retired-terms"]).toEqual([]);
	});

	it("keeps a one-call handle take alive when cancellation commits between phases", async () => {
		const root = tempRoot();
		const slug = "demo";
		const sliceId = "s7";
		const seedHandle = await seededFileBoard(root, slug, sliceId);
		const base = seedHandle.store;
		await apply({
			board: seedHandle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "race-phase-register-A",
		});
		await apply({
			board: seedHandle,
			command: { type: "registerActor", agentId: "B", slotId: "slot-B" },
			turnId: "turn-1",
			requestId: "race-phase-register-B",
		});
		await apply({
			board: seedHandle,
			command: { type: "addTasks", tasks: [tokenTask()] },
			actor: "A",
			turnId: "turn-1",
			requestId: "race-phase-add",
		});

		let arm = false;
		let injected = false;
		const store = {
			durable: true,
			read: (...args) => base.read(...args),
			initialize: (...args) => base.initialize(...args),
			async transaction(fn) {
				const result = await base.transaction(fn);
				if (arm && !injected) {
					injected = true;
					const cancelHandle = openBoard(root, slug, sliceId);
					const cancel = await apply({
						board: cancelHandle,
						command: {
							type: "cancel",
							taskId: "T-1",
							reason: "cancelled between acceptance and resolution",
						},
						actor: "B",
						turnId: "race-cancel",
						requestId: "race-phase-cancel",
					});
					expect(cancel.ok).toBe(true);
				}
				return result;
			},
		};
		const handle = openBoard(root, slug, sliceId, { store });
		arm = true;
		const result = await apply({
			board: handle,
			command: {
				type: "takeOrDie",
				confirm: TAKE_OR_DIE_CONFIRMATION,
				handoffMarkdown: "A hands off",
			},
			actor: "A",
			turnId: "race-take",
			requestId: "race-phase-take",
		});
		expect(result.ok).toBe(true);
		expect(result.receipt.outcome).toBe("attempt-won");
		expect(injected).toBe(true);

		const state = await readBoard(openBoard(root, slug, sliceId));
		expect(state["token-slot"]["holder-id"]).toBeNull();
		expect(state.actors.A["life-state"]).toBe("dead");
		expect(state["take-attempts"]["race-phase-take:accept"].resolved).toBe(true);
		expect(state["take-attempts"]["race-phase-take:accept"].outcome).toBe("attempt-won");
	});

	it("reports BOARD_CONFLICT when the real board lock stays busy", async () => {
		const root = tempRoot();
		const handle = await seededFileBoard(root, "demo", "s4", { lockTimeoutMs: 40 });
		const registered = await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "lock-register",
		});
		expect(registered.ok).toBe(true);

		const lock = await acquireLock(handle.lockPath, {
			lock_id: "test-board-lock",
			purpose: "board",
			slice_id: "s4",
			token: "test-board-token",
			pid: process.pid,
			started_at: new Date().toISOString(),
		});
		expect(lock.ok).toBe(true);
		let caught;
		try {
			await apply({
				board: handle,
				command: { type: "registerActor", agentId: "B", slotId: "slot-B" },
				turnId: "turn-2",
				requestId: "lock-blocked",
			});
		} catch (error) {
			caught = error;
		}
		expect(caught?.code).toBe(":BOARD_CONFLICT");
		expect((await releaseLock(lock.handle)).released).toBe(true);
		const state = await readBoard(handle);
		expect(state["board-version"]).toBe(1);
		expect(state.actors.B).toBeUndefined();
	});

	it("does not overwrite a corrupt board", async () => {
		const root = tempRoot();
		const handle = openBoard(root, "demo", "s5");
		mkdirSync(join(root, ".herd", "missions", "demo", "slices", "s5"), {
			recursive: true,
		});
		writeFileSync(handle.boardPath, "{not edn", "utf8");
		expect(await readBoard(handle)).toBeNull();

		const result = await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-corrupt",
			requestId: "corrupt-write",
		});
		expect(result.ok).toBe(false);
		expect(result.error.code).toBe(":STALE_CONTROL");
		expect(readFileSync(handle.boardPath, "utf8")).toBe("{not edn");
	});

	it("rejects a persisted legacy object wait_for at read time", async () => {
		const root = tempRoot();
		const sliceId = "s5-legacy";
		const handle = openBoard(root, "demo", sliceId);
		mkdirSync(join(root, ".herd", "missions", "demo", "slices", sliceId), { recursive: true });
		const legacy = `{:board-version 1
 :tasks {"T-1" {:task-id "T-1" :state :ready :wait-for [{:condition "gate-open"}]}}
 :actors {}
 :actions {}
 :token-slot {:state :free}
 :next-ids {}}
`;
		writeFileSync(handle.boardPath, legacy, "utf8");
		expect(await readBoard(handle)).toBeNull();

		const result = await apply({
			board: handle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-legacy",
			requestId: "legacy-write",
		});
		expect(result.ok).toBe(false);
		expect(result.error.code).toBe(":STALE_CONTROL");
		expect(readFileSync(handle.boardPath, "utf8")).toBe(legacy);
	});

	it("refuses to rebuild a missing board while a checkpoint still exists", async () => {
		const root = tempRoot();
		const sliceId = "s5b";
		const seedHandle = await seededFileBoard(root, "demo", sliceId);
		await apply({
			board: seedHandle,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-1",
			requestId: "ledger-seed",
		});
		expect(existsSync(seedHandle.checkpointPath)).toBe(true);
		rmSync(seedHandle.boardPath, { force: true });

		const reopened = openBoard(root, "demo", sliceId);
		const result = await apply({
			board: reopened,
			command: { type: "registerActor", agentId: "B", slotId: "slot-B" },
			turnId: "turn-2",
			requestId: "ledger-missing",
		});
		expect(result.ok).toBe(false);
		expect(result.error.code).toBe(":STALE_CONTROL");
		expect(existsSync(seedHandle.boardPath)).toBe(false);

		let caught;
		try {
			await reopened.store.initialize(initialBoard());
		} catch (error) {
			caught = error;
		}
		expect(caught?.code).toBe(":STALE_CONTROL");
		expect(existsSync(seedHandle.boardPath)).toBe(false);
	});

	it("rejects initialize when the board would be unreadable", async () => {
		const root = tempRoot();
		const store = createFileBoardStore({
			boardPath: join(root, "board.edn"),
			eventsPath: join(root, "events.jsonl"),
			checkpointPath: join(root, "checkpoint.edn"),
			lockPath: join(root, "board.lock"),
		});
		let caught;
		try {
			await store.initialize({ "board-version": 0, tasks: {}, actors: {} });
		} catch (error) {
			caught = error;
		}
		expect(caught?.code).toBe(":INVALID_ARGUMENT");
		expect(await store.read()).toBeNull();
		expect(existsSync(join(root, "board.edn"))).toBe(false);
	});

	it("treats a store-only handle without durable as durable", async () => {
		const root = tempRoot();
		const sliceId = "s9";
		const handle = openBoard(root, "demo", sliceId);
		mkdirSync(join(root, ".herd", "missions", "demo", "slices", sliceId), {
			recursive: true,
		});
		writeFileSync(handle.boardPath, "{not edn", "utf8");
		const minimal = { boardPath: handle.boardPath, store: handle.store };
		const result = await apply({
			board: minimal,
			command: { type: "registerActor", agentId: "A", slotId: "slot-A" },
			turnId: "turn-minimal",
			requestId: "minimal-handle",
		});
		expect(result.ok).toBe(false);
		expect(result.error.code).toBe(":STALE_CONTROL");
		expect(readFileSync(handle.boardPath, "utf8")).toBe("{not edn");
	});

	it("supports explicit file store initialization", async () => {
		const root = tempRoot();
		const boardPath = join(root, "board.edn");
		const store = createFileBoardStore({
			boardPath,
			eventsPath: join(root, "events.jsonl"),
			checkpointPath: join(root, "checkpoint.edn"),
			lockPath: join(root, "board.lock"),
		});
		const seeded = await store.initialize(initialBoard());
		expect(seeded["board-version"]).toBe(0);
		expect(await store.read()).toEqual(initialBoard());
		expect(readFileSync(boardPath, "utf8")).toContain(":board-version 0");
	});
});
