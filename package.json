{
  "name": "herdchestra-lite",
  "version": "1.0.0",
  "description": "ClojureScript sandbox dogfood surface for omp",
  "type": "module",
  "license": "MIT",
  "private": false,
  "omp": {
    "extensions": [
      "./src/clj-main.mjs"
    ]
  },
  "pi": {
    "extensions": [
      "./src/clj-main.mjs"
    ]
  },
  "exports": {
    ".": "./src/main.mjs",
    "./bootstrap-main": "./src/bootstrap-main.mjs",
    "./package.json": "./package.json",
    "./clj-main": "./src/clj-main.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@chrisoakman/standard-clojure-style": "0.29.0",
    "highlight.js": "^11.12.0",
    "nbb": "1.6.215"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "scripts": {
    "test": "bun test tests/fast.test.mjs",
    "test:full": "bun test tests --parallel",
    "test:suite": "bun test tests --parallel",
    "check": "biome check .",
    "format": "biome format --write ."
  }
}
